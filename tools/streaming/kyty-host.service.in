[Unit]
Description=Kyty streaming host
After=graphical-session.target pipewire.service wireplumber.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@COMMAND@ --host
Restart=on-failure
RestartSec=3
KillMode=mixed
TimeoutStopSec=110

[Install]
WantedBy=graphical-session.target
