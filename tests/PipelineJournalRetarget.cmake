# A journal from an older translator can have keys already known to the driver while the
# modules published for its permutation identities now produce different pipeline keys.
if(STALE_LAYOUT)
  set(work "${CMAKE_CURRENT_BINARY_DIR}/pipeline-retarget-layout")
  set(rewrite_mode --stale-layout-journal)
else()
  set(work "${CMAKE_CURRENT_BINARY_DIR}/pipeline-retarget-known")
  set(rewrite_mode --stale-known-journal)
endif()
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")
file(WRITE "${work}/param.json" "{\"titleId\":\"PPSA00001\",\"contentVersion\":\"01.000\"}")
set(ENV{KYTY_PIPELINE_CACHE_PATH} "${work}/driver.bin")
set(ENV{KYTY_PIPELINE_KNOWN_PATH} "${work}/known.bin")
set(ENV{KYTY_PIPELINE_JOURNAL_PATH} "${work}/pipelines.bin")
set(ENV{KYTY_SHADER_PRECOMPILE_PATH} "${work}/shaders.bin")
set(ENV{KYTY_PROGRAM_CACHE} 0)
set(ENV{KYTY_PIPELINE_JOURNAL} 1)
set(ENV{KYTY_PIPELINE_JOURNAL_LEVEL} fixture)
set(ENV{KYTY_PIPELINE_KNOWN} 1)
set(ENV{KYTY_SHADER_PRECOMPILE} 1)
set(ENV{KYTY_SHADER_PRECOMPILE_WAIT} 1)
set(ENV{KYTY_PIPELINE_JOURNAL_WAIT} 1)
set(ENV{KYTY_PIPELINE_JOURNAL_FORCE} 0)
set(ENV{KYTY_PIPELINE_JOURNAL_RETARGET} 1)
set(ENV{KYTY_PIPELINE_FAST_FIRST} 0)
set(ENV{KYTY_PIPELINE_PREFETCH} 0)
set(ENV{KYTY_PIPELINE_LIST} 0)
set(ENV{KYTY_PIPELINE_LIST_PREPARE} 0)
set(ENV{KYTY_DRAW_PREP} off)
set(ENV{KYTY_DRAW_PREP_BINDINGS} 1)
set(ENV{KYTY_DRAW_PREP_VERIFY} exit)
set(ENV{KYTY_PIPELINE_COLD_SALT} 176)
function(run_fixture label)
  execute_process(COMMAND "${FIXTURE}" --pipeline-journal-fixture "${work}/param.json"
      WORKING_DIRECTORY "${work}" RESULT_VARIABLE result
      OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
  file(WRITE "${work}/${label}.log" "${output}\n${errors}")
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "${label}: ${result}\n${output}\n${errors}")
  endif()
  set(last_output "${output}\n${errors}" PARENT_SCOPE)
endfunction()
run_fixture(seed)
execute_process(COMMAND "${JOURNAL_TOOL}" ${rewrite_mode}
    "${work}/pipelines.bin" "${work}/known.bin" RESULT_VARIABLE rewrite)
if(NOT "${rewrite}" STREQUAL "0")
  message(FATAL_ERROR "Cannot create the old-translator journal fixture: ${rewrite}")
endif()
if(STALE_LAYOUT)
  # Compare the retargeted keys with the real pipelines subsequently drawn by the
  # fixture. Accepting the old descriptor layout would warm unrelated keys.
  set(ENV{KYTY_PIPELINE_JOURNAL_VERIFY} 1)
endif()
set(ENV{KYTY_PIPELINE_FAST_FIRST} 0)
set(ENV{KYTY_PIPELINE_FAST_FIRST_PROBE} 0)
run_fixture(retarget)
if(last_output MATCHES "[1-9][0-9]* with modules not published|[1-9][0-9]* failed" OR
   NOT last_output MATCHES "[1-9][0-9]* with another translator's modules")
  message(FATAL_ERROR "Retargeting missed compatible modules or did not rematch shaders; see ${work}/retarget.log")
endif()
if(NOT last_output MATCHES "Pipeline journal: replay done[^\n]*: [1-9][0-9]* built")
  message(FATAL_ERROR "Old known keys prevented current-module preparation; see ${work}/retarget.log")
endif()
if(STALE_LAYOUT)
  string(REGEX MATCHALL "Pipeline replay coverage: [0-9]+ of [0-9]+ graphics pipelines" coverage "${last_output}")
  set(drawn 0)
  foreach(row IN LISTS coverage)
    string(REGEX MATCH "([0-9]+) of ([0-9]+)" counts "${row}")
    if(NOT CMAKE_MATCH_1 STREQUAL CMAKE_MATCH_2)
      message(FATAL_ERROR "Retargeted layout does not match the real draw pipelines: ${row}")
    endif()
    math(EXPR drawn "${drawn} + ${CMAKE_MATCH_2}")
  endforeach()
  if(drawn EQUAL 0)
    message(FATAL_ERROR "No real draw pipelines checked")
  endif()
endif()
run_fixture(warm)
if(NOT last_output MATCHES "Pipeline journal: replay done[^\n]*: 0 built" OR
   last_output MATCHES "Pipeline journal: replay done[^\n]*: [1-9][0-9]* built" OR
   last_output MATCHES "[1-9][0-9]* with modules not published|[1-9][0-9]* failed")
  message(FATAL_ERROR "The next launch failed to reuse prepared current keys; see ${work}/warm.log")
endif()
