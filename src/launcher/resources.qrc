  <file alias="global-settings.svg">icons/global-settings.svg</file>
  <file alias="input-mapping.svg">icons/input-mapping.svg</file>
  <file alias="refresh.svg">icons/refresh.svg</file>
  <file alias="grid-view.svg">icons/grid-view.svg</file>
  <file alias="remove-configuration.svg">icons/remove-configuration.svg</file>
  <file alias="trophy.svg">icons/trophy.svg</file>
  <file alias="kyty.svg">icons/kyty.svg</file>
  <file alias="kyty-small.svg">icons/kyty-small.svg</file>
