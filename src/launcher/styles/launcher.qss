QListView#cfgs_grid {
    background: palette(base);
    border: 1px solid palette(mid);
    color: palette(text);
}

QListView#cfgs_grid::item {
    padding: 8px;
}

GameListTreeWidget#cfgs_list {
    background: transparent;
    border: 1px solid palette(mid);
    color: palette(text);
    outline: 0;
}

GameListTreeWidget#cfgs_list::item {
    background: transparent;
    border-bottom: 1px solid palette(mid);
    padding: 4px;
}

GameListTreeWidget#cfgs_list::item:selected {
    background: palette(highlight);
    color: palette(highlighted-text);
}

GameListTreeWidget#cfgs_list QHeaderView::section {
    background: palette(button);
    color: palette(button-text);
    border: 0;
    border-right: 1px solid palette(mid);
    border-bottom: 1px solid palette(mid);
    padding: 5px 6px;
}

QLineEdit#search_line_edit {
    background: palette(base);
    border: 1px solid palette(mid);
    border-radius: 4px;
    color: palette(text);
    padding: 5px 8px;
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

QLineEdit#search_line_edit:focus {
    border-color: palette(highlight);
}

QToolButton#grid_view_button,
QToolButton#refresh_button,
QToolButton#global_settings_button,
QToolButton#input_mapping_button,
QToolButton#edit_button,
QToolButton#trophy_overview_button,
QToolButton#delete_button {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 3px;
}

QToolButton#grid_view_button:hover,
QToolButton#refresh_button:hover,
QToolButton#global_settings_button:hover,
QToolButton#input_mapping_button:hover,
QToolButton#edit_button:hover,
QToolButton#trophy_overview_button:hover,
QToolButton#delete_button:hover {
    background: palette(button);
    border-color: palette(mid);
}

QToolButton#grid_view_button:checked,
QToolButton#grid_view_button:pressed,
QToolButton#refresh_button:pressed,
QToolButton#global_settings_button:pressed,
QToolButton#input_mapping_button:pressed,
QToolButton#edit_button:pressed,
QToolButton#trophy_overview_button:pressed,
QToolButton#delete_button:pressed {
    background: palette(midlight);
}

QComboBox#game_status_editor {
    background: transparent;
    border: 0;
    color: palette(text);
    padding-left: 2px;
}

QComboBox#game_status_editor:focus {
    background: palette(button);
    border-radius: 3px;
}

QComboBox#game_status_editor::drop-down {
    border: 0;
}

QComboBox#game_status_editor QAbstractItemView {
    background: palette(base);
    color: palette(text);
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

QLineEdit#game_comment_editor {
    background: transparent;
    border: 0;
    color: palette(text);
    padding-left: 2px;
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
}

QLineEdit#game_comment_editor:focus {
    background: palette(base);
    border: 1px solid palette(mid);
    border-radius: 3px;
}

QLabel#game_status_indicator {
    border: 1px solid palette(base);
    border-radius: 6px;
}

/* One scalable library surface, shared by desktop and couch-sized windows. */
QWidget#libraryPage { background: palette(window); color: palette(window-text); }
QWidget#libraryPage QStackedWidget > QWidget { background: palette(window); }
QWidget#libraryPage QLabel { color: palette(window-text); background: transparent; }
QLabel#libraryHeading { font-size: 24px; font-weight: 600; }
QWidget#libraryPage QPushButton, QWidget#libraryPage QLineEdit {
    background: #292d35; color: #f2f3f7; border: 2px solid #454c59;
    border-radius: 10px; padding: 12px 18px; min-height: 24px;
}
QWidget#libraryPage QPushButton:hover { background: #363d49; }
QWidget#libraryPage QPushButton:focus, QWidget#libraryPage QLineEdit:focus {
    border: 2px solid #91baff;
}
QWidget#libraryPage QPushButton:disabled { color: #9399a6; background: #22252b; }
QListWidget#libraryGames { background: palette(window); color: palette(window-text); border: 2px solid #454c59; border-radius: 12px; padding: 8px; }
QListWidget#libraryGames::item { background: #292d35; color: #f2f3f7; padding: 12px; border: 2px solid transparent; border-radius: 10px; }
QListWidget#libraryGames::item:selected { background: #354b70; color: #f2f3f7; border: 2px solid #91baff; }
QListWidget#libraryGames:focus { border: 2px solid #91baff; }
QPushButton#libraryPlay { background: #315f9f; font-weight: 600; }

QWidget#libraryDetailBody, QWidget#libraryPage QScrollArea, QWidget#libraryPage QScrollArea > QWidget > QWidget { background: palette(window); }
